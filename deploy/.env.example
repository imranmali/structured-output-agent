# Copy to deploy/.env (git-ignored) and fill in. Used by docker-compose.yml.
# Every SOA_* variable is documented in docs/deployment.md.

# Claude API key used by the service (required for runs; probes work without).
ANTHROPIC_API_KEY=

# Comma-separated keys clients must send as "Authorization: Bearer <key>" or
# "X-API-Key: <key>". Empty disables authentication - only do that locally.
SOA_API_KEYS=

# Output contracts to serve, as module:Class (comma-separated).
SOA_MODELS=structured_output_agent.cli:WeatherReport

# SOA_LLM_MODEL=claude-opus-5-5
# SOA_MAX_IN_FLIGHT=32
# SOA_RUN_TIMEOUT=300
# SOA_LOG_FORMAT=text
